# Server-only AI configuration. Never put this key in Flutter dart-defines or web JavaScript.
OPENAI_API_KEY=
KYR_OPENAI_MODEL=gpt-5.6-terra

# Local development examples
KYR_DEVELOPMENT_MODE=1
KYR_APP_SECRET=replace-with-at-least-32-random-characters

# Managed authentication. SUPABASE_SECRET_KEY is server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Production delivery callbacks
KYR_PUBLIC_BASE_URL=https://your-public-app.example
KYR_DELIVERY_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret

# Optional alert channels
TWILIO_WHATSAPP_FROM=+14155238886
KYR_PUSH_WEBHOOK_URL=https://your-push-worker.example/send
KYR_PUSH_WEBHOOK_SECRET=replace-with-a-push-worker-secret
