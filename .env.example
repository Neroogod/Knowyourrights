# Server-only AI configuration. Never put this key in Flutter dart-defines or web JavaScript.
OPENAI_API_KEY=
KYR_OPENAI_MODEL=gpt-5.6-terra
KYR_EMBEDDING_PROVIDER=local
KYR_EMBEDDING_MODEL=BAAI/bge-m3
KYR_EMBEDDING_MODEL_VERSION=main
KYR_EMBEDDING_DIMENSIONS=1024
KYR_AI_DAILY_QUOTA=50
KYR_AI_CACHE_TTL_SECONDS=21600
KYR_AI_REVIEW_SAMPLE_RATE=0.02
# Set these only when the configured generator has token pricing.
KYR_AI_INPUT_COST_PER_MILLION=0
KYR_AI_OUTPUT_COST_PER_MILLION=0
# Fail startup unless PostgreSQL, the embedding runtime, and complete active-version
# embeddings are available. Enable only after the evaluation workflow passes.
KYR_AI_PRODUCTION_ENABLED=0

# Local development examples
KYR_DEVELOPMENT_MODE=1
KYR_APP_SECRET=replace-with-at-least-32-random-characters
# Optional URL-safe base64 Ed25519 private seed (32 bytes). If omitted, a
# distinct content-signing key is deterministically derived from KYR_APP_SECRET.
KYR_CONTENT_SIGNING_PRIVATE_KEY=

# Managed authentication. SUPABASE_SECRET_KEY is server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# PostgreSQL source of truth for accounts and versioned legal content.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/knowyourrights
KYR_CONTENT_BACKEND=database
# Use only for a new environment; production deploys should import explicitly.
KYR_CONTENT_AUTO_IMPORT=0

# Production delivery callbacks
KYR_PUBLIC_BASE_URL=https://your-public-app.example
KYR_DELIVERY_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret

# Optional alert channels
TWILIO_WHATSAPP_FROM=+14155238886
KYR_PUSH_WEBHOOK_URL=https://your-push-worker.example/send
KYR_PUSH_WEBHOOK_SECRET=replace-with-a-push-worker-secret
